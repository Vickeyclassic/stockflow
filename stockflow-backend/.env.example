# Reference only: export backend variables in your terminal or IDE.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=
JWT_TTL_SECONDS=3600
# Optional first administrator, dev or explicit bootstrap profile; no plaintext password.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD_HASH=
# Opt-in demo seed: requires dev and is disabled whenever prod is active.
APP_DEMO_ENABLED=false
# Existing V1/V1.1 databases only: opt in once after backup and schema review.
FLYWAY_BASELINE_ON_MIGRATE=false
# Defaults to true in development and false in production.
API_DOCS_ENABLED=true
