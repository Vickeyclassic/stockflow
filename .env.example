# Copy to .env; replace placeholders locally. Never commit real values.
DB_PASSWORD=replace-with-a-unique-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
JWT_SECRET=replace-with-base64-of-at-least-32-random-bytes
HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Enable only for the first V1/V1.1 adoption after reviewing/backing up the database.
FLYWAY_BASELINE_ON_MIGRATE=false
API_DOCS_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
# Only for explicit first-admin bootstrap. Single-quote a BCrypt hash to preserve $.
BOOTSTRAP_ADMIN_PASSWORD_HASH=
